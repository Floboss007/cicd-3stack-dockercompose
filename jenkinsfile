pipeline {
    agent any

    stages {
       
        stage('Checkout') {
            steps {
                echo 'pulling latest code from git'
                checkout scm
            }
        }
        stage('check-package-json') {
            steps {
                dir("api") {
                    echo 'checking files...'
                    sh '[ -f package.json ] && [ -f server.js ] && [ -f Dockerfile ]' 
                }
                
            }
        }
        stage('Test') {
            steps {
                dir('api') { // Navigate to the directory containing package.json
                // 1. Verify package.json syntax and structure
                sh 'npm install --package-lock-only'
                
                // 2. Scan dependencies for known security vulnerabilities
                sh 'npm audit --audit-level=high'
                
                // 3. (Optional) Run code linting if configured
                // sh 'npm run lint'
                
                // 4. Run your unit test suite defined in package.json
                sh 'npm test'
            }
    }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
                sh 'docker compose up -d --build api'
            }
        }
    }

    post {
        success {
            echo "app updated successfully"
        }
        failure {
            echo 'Pipeline failed — check the stage logs above to see where.'
        }
    }

}