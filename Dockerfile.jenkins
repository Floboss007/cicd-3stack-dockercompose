FROM jenkins/jenkins:lts-jdk17

USER root

# Node.js, npm, and native Docker CLI packages
RUN apt-get update && \
    apt-get install -y nodejs npm docker.io docker-compose && \
    rm -rf /var/lib/apt/lists/*


# Skip the setup wizard so Jenkins is usable immediately after 'docker compose up'.
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false"

# Pre-install the plugins the pipeline needs, so nothing is done live via the UI.
RUN jenkins-plugin-cli --plugins \
    git \
    workflow-aggregator \
    pipeline-stage-view credentials-binding

    

USER jenkins
